#!/usr/bin/env zsh
# shellcheck shell=bash # zsh file; linted as bash since shellcheck doesn't support zsh

set -x

sudo -v &&
    brew update &&
    brew upgrade &&
    echo 'y' | gcloud components update &&
    gem update --system &&
    sudo managedsoftwareupdate --auto &&
    "$HOME/Development/topsoil/compost" backend
